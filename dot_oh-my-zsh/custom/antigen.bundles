# First of all source the antigen script
source $ZSH_CUSTOM/antigen.zsh

# Load the oh-my-zsh's library.
antigen use oh-my-zsh

#----------------------------------------------------------------------
# Bundles from custom plugins
##----------------------------------------------------------------------
# Auto-completion definitions
antigen bundle zsh-users/zsh-completions

# It suggests commands as you type based on history and completions.
antigen bundle zsh-users/zsh-autosuggestions

# Jump quickly to directories that you have visited frecency
antigen bundle agkozak/zsh-z

# Enhanced cd
# (repo moved from b4b4r07 and its default branch is main; antigen v2 assumes
# master unless told otherwise)
antigen bundle babarot/enhancd --branch=main

# Clipboard manager for pbcopy and pbpaste across machines
antigen bundle zpm-zsh/clipboard

# Tell Antigen that you're done.
antigen apply
